@inject ProfileService ProfileService
@inject AppStateService AppState
@implements IDisposable

<div class="relative inline-block text-left select-none">
    <button type="button"
            @onclick="ToggleDropdown"
            class="inline-flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium transition-colors hover:bg-black/5 dark:hover:bg-white/5 @(string.IsNullOrEmpty(AppState.CurrentProfileName) ? "text-muted-foreground" : "text-foreground")"
            title="项目环境配置切换器">
        <svg class="h-4 w-4 shrink-0 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m6 14 1.45-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H18a2 2 0 0 1 2 2v2"></path>
        </svg>
        <span class="max-w-[9rem] truncate text-xs">
            @(string.IsNullOrEmpty(AppState.CurrentProfileName) ? "未选择配置" : AppState.CurrentProfileName)
        </span>
        <svg class="h-3.5 w-3.5 shrink-0 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="7 15 12 20 17 15"></polyline>
            <polyline points="7 9 12 4 17 9"></polyline>
        </svg>
    </button>

    @if (isOpen)
    {
        <div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>
        <div class="absolute left-0 top-full mt-1.5 z-50 w-64 rounded-xl border border-border bg-popover text-popover-foreground shadow-lg overflow-hidden py-1">
            <!-- Search -->
            <div class="px-2.5 py-1.5 border-b border-border/60">
                <input type="text"
                       placeholder="搜索配置..."
                       class="w-full bg-transparent text-xs text-foreground placeholder:text-muted-foreground focus:outline-none"
                       @bind="searchQuery"
                       @bind:event="oninput" />
            </div>

            <!-- Profile List -->
            <div class="max-h-48 overflow-y-auto py-1">
                @if (!FilteredProfiles.Any())
                {
                    <div class="px-3 py-2 text-xs text-muted-foreground text-center">暂无配置</div>
                }
                else
                {
                    @foreach (var p in FilteredProfiles)
                    {
                        bool isSelected = p.Id == AppState.CurrentProfileId;
                        <button type="button"
                                @onclick="() => SelectProfile(p)"
                                class="w-full flex items-center px-3 py-1.5 text-xs text-left hover:bg-muted/80 transition-colors">
                            <svg class="mr-2 h-3.5 w-3.5 shrink-0 text-primary @(isSelected ? "opacity-100" : "opacity-0")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span class="truncate flex-1">@p.Name</span>
                        </button>
                    }
                }
            </div>

            <div class="h-px bg-border/60 my-1"></div>

            <!-- Actions -->
            <div class="py-0.5 px-1 space-y-0.5">
                <button type="button"
                        @onclick="OpenCreateDialog"
                        class="w-full flex items-center gap-2 px-2.5 py-1.5 text-xs rounded-lg hover:bg-muted transition-colors text-foreground">
                    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    从当前创建配置
                </button>

                @if (!string.IsNullOrEmpty(AppState.CurrentProfileId))
                {
                    <button type="button"
                            @onclick="ClearProfile"
                            class="w-full flex items-center gap-2 px-2.5 py-1.5 text-xs rounded-lg hover:bg-muted transition-colors text-muted-foreground hover:text-destructive">
                        <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                        清除当前配置
                    </button>
                }
            </div>
        </div>
    }

    <!-- Create Profile Dialog -->
    <Dialog IsOpen="isCreateOpen"
            Title="从当前创建配置"
            Description="为当前已配置的服务商和环境保存快照"
            OnClose="() => isCreateOpen = false">
        <div class="space-y-3 py-2">
            <Input Label="配置名称"
                   Placeholder="例如：工作主力 / 个人开发"
                   @bind-Value="newProfileName" />
        </div>
        <div class="flex items-center justify-end gap-2 pt-3 border-t border-border/50">
            <Button Variant="outline" Size="sm" OnClick="() => isCreateOpen = false">取消</Button>
            <Button Variant="default" Size="sm" OnClick="ConfirmCreate">保存配置</Button>
        </div>
    </Dialog>
</div>

@code {
    private bool isOpen = false;
    private bool isCreateOpen = false;
    private string searchQuery = "";
    private string newProfileName = "";
    private List<ProfileDto> profiles = new();

    protected override async Task OnInitializedAsync()
    {
        AppState.OnStateChanged += HandleUpdate;
        await LoadProfiles();
    }

    private void HandleUpdate()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadProfiles()
    {
        try
        {
            var res = await ProfileService.ListProfilesAsync();
            profiles = res.Profiles;
        }
        catch { }
    }

    private IEnumerable<ProfileDto> FilteredProfiles =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? profiles
            : profiles.Where(p => p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private void ToggleDropdown()
    {
        isOpen = !isOpen;
    }

    private void CloseDropdown()
    {
        isOpen = false;
    }

    private async Task SelectProfile(ProfileDto profile)
    {
        AppState.SetCurrentProfile(profile.Id, profile.Name);
        isOpen = false;
        await ProfileService.ApplyProfileAsync(profile.Id);
    }

    private async Task ClearProfile()
    {
        AppState.SetCurrentProfile(null, null);
        isOpen = false;
        await ProfileService.ClearCurrentProfileAsync();
    }

    private void OpenCreateDialog()
    {
        isOpen = false;
        newProfileName = "";
        isCreateOpen = true;
    }

    private async Task ConfirmCreate()
    {
        if (string.IsNullOrWhiteSpace(newProfileName)) return;

        var p = await ProfileService.CreateProfileAsync(newProfileName.Trim(), AppState.CurrentApp);
        isCreateOpen = false;
        await LoadProfiles();
        AppState.SetCurrentProfile(p.Id, p.Name);
    }

    public void Dispose()
    {
        AppState.OnStateChanged -= HandleUpdate;
    }
}
