@inject ToastService ToastService
@implements IDisposable

@{
    var toasts = ToastService.GetToasts();
}

@if (toasts.Count > 0)
{
    <div class="fixed top-20 right-6 z-50 flex flex-col gap-2.5 max-w-sm w-full pointer-events-none select-none">
        @foreach (var toast in toasts)
        {
            <div class="pointer-events-auto flex items-start gap-3 p-3.5 rounded-xl border shadow-xl backdrop-blur-md transition-all duration-200 animate-in fade-in slide-in-from-top-3 @GetToastClasses(toast)"
                 style="@(toast.IsClosing ? "opacity: 0; transform: translateY(-8px); transition: all 200ms ease-out;" : "")">
                
                <!-- Icon Indicator -->
                <div class="shrink-0 mt-0.5">
                    @switch (toast.Type)
                    {
                        case ToastType.Success:
                            <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-500 flex items-center justify-center">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </div>
                            break;
                        case ToastType.Error:
                            <div class="w-5 h-5 rounded-full bg-rose-500/20 text-rose-500 flex items-center justify-center">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </div>
                            break;
                        case ToastType.Warning:
                            <div class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-500 flex items-center justify-center">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                    <line x1="12" y1="9" x2="12" y2="13"></line>
                                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                </svg>
                            </div>
                            break;
                        default:
                            <div class="w-5 h-5 rounded-full bg-blue-500/20 text-blue-500 flex items-center justify-center">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                            </div>
                            break;
                    }
                </div>

                <!-- Text Content -->
                <div class="min-w-0 flex-1">
                    <div class="text-xs font-semibold text-foreground tracking-tight leading-tight">
                        @toast.Title
                    </div>
                    @if (!string.IsNullOrWhiteSpace(toast.Message))
                    {
                        <div class="text-[11px] text-muted-foreground mt-0.5 leading-snug break-words">
                            @toast.Message
                        </div>
                    }
                </div>

                <!-- Close Button -->
                <button type="button"
                        @onclick="() => DismissToast(toast.Id)"
                        class="shrink-0 p-1 rounded-md text-muted-foreground hover:text-foreground hover:bg-muted/40 transition-colors focus:outline-none"
                        title="关闭提示">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        ToastService.OnToastsChanged += HandleToastsChanged;
    }

    private void HandleToastsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task DismissToast(string id)
    {
        await ToastService.DismissAsync(id);
    }

    private string GetToastClasses(ToastItem toast)
    {
        return toast.Type switch
        {
            ToastType.Success => "bg-card/95 border-emerald-500/40 shadow-emerald-500/10",
            ToastType.Error => "bg-card/95 border-rose-500/40 shadow-rose-500/10",
            ToastType.Warning => "bg-card/95 border-amber-500/40 shadow-amber-500/10",
            _ => "bg-card/95 border-blue-500/30 shadow-blue-500/10"
        };
    }

    public void Dispose()
    {
        ToastService.OnToastsChanged -= HandleToastsChanged;
    }
}
