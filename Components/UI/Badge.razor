<span class="@GetClasses()">
    @ChildContent
</span>

@code {
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Class { get; set; } = "";

    private string GetClasses()
    {
        var baseClasses = "inline-flex items-center font-medium rounded-full text-[10px] px-2 py-0.5 transition-colors";
        var variantClasses = Variant switch
        {
            "secondary" => "bg-muted text-muted-foreground border border-border/50",
            "destructive" => "bg-destructive/10 text-destructive border border-destructive/20",
            "success" => "bg-green-500/10 text-green-500 border border-green-500/20",
            "warning" => "bg-amber-500/10 text-amber-500 border border-amber-500/20",
            "outline" => "text-foreground border border-border",
            _ => "bg-primary/10 text-primary border border-primary/20"
        };
        return $"{baseClasses} {variantClasses} {Class}".Trim();
    }
}
