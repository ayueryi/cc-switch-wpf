@inject StreamCheckService StreamCheckService
@inject ProviderStateService ProviderState
@inject AppStateService AppState

<div class="@GetCardClass() p-4 rounded-xl transition-all duration-200 flex flex-col justify-between gap-3 group relative border">
    <!-- Card Header -->
    <div class="flex items-start justify-between gap-2.5">
        <div class="flex items-center gap-3 min-w-0">
            <!-- Brand Icon -->
            <ProviderIcon Name="@Provider.Name" Size="32" ClassName="shrink-0" />

            <div class="min-w-0">
                <div class="flex items-center gap-1.5 flex-wrap">
                    <h3 class="font-semibold text-xs truncate text-foreground">@Provider.Name</h3>
                    @if (IsActive)
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-green-500/10 text-green-600 dark:text-green-400 border border-green-500/20">
                            当前生效
                        </span>
                    }
                    @if (Provider.Category == "official")
                    {
                        <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[9px] font-medium bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
                            官方
                        </span>
                    }
                    @if (Provider.InFailoverQueue)
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                            故障转移
                        </span>
                    }
                </div>
                <p class="text-[11px] text-muted-foreground truncate mt-0.5 font-mono">
                    @(string.IsNullOrEmpty(Provider.Notes) ? (Provider.WebsiteUrl ?? "默认官方端点") : Provider.Notes)
                </p>
            </div>
        </div>

        <!-- Category Tag -->
        @if (!string.IsNullOrEmpty(Provider.Category) && Provider.Category != "official")
        {
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-muted text-muted-foreground border border-border/40 flex-shrink-0">
                @Provider.Category
            </span>
        }
    </div>

    <!-- Card Footer / Actions -->
    <div class="flex items-center justify-between pt-2.5 border-t border-border/40 text-[11px]">
        <!-- Latency Check Info -->
        <div class="flex items-center gap-1.5">
            @if (IsChecking)
            {
                <span class="text-[10px] text-muted-foreground flex items-center gap-1">
                    <svg class="animate-spin h-3 w-3 text-primary" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    测速中...
                </span>
            }
            else if (LatencyResult != null)
            {
                if (LatencyResult.IsOk)
                {
                    <span class="@GetLatencyClass(LatencyResult.LatencyMs) font-mono text-[10px] flex items-center gap-1 px-1.5 py-0.5 rounded bg-muted/50">
                        <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                        @(LatencyResult.LatencyMs)ms
                    </span>
                }
                else
                {
                    <span class="text-red-500 font-mono text-[10px] flex items-center gap-1 px-1.5 py-0.5 rounded bg-red-500/10" title="@LatencyResult.Message">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                        连接失败
                    </span>
                }
            }
            else
            {
                <button class="text-[10px] text-muted-foreground hover:text-foreground underline-offset-2 hover:underline cursor-pointer"
                        @onclick="() => OnCheckLatency.InvokeAsync(Provider.Id)">
                    测速
                </button>
            }
        </div>

        <!-- Right Buttons -->
        <div class="flex items-center gap-1.5">
            <Button Variant="ghost" Size="sm" OnClick="() => OnEdit.InvokeAsync(Provider)">
                编辑
            </Button>

            @if (!IsActive)
            {
                <Button Variant="secondary" Size="sm" OnClick="HandleSwitch">
                    切换
                </Button>
            }
            else
            {
                <Button Variant="success" Size="sm" Disabled="true">
                    当前使用
                </Button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public ProviderDto Provider { get; set; } = null!;
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public bool IsChecking { get; set; }
    [Parameter] public StreamCheckResultDto? LatencyResult { get; set; }
    [Parameter] public EventCallback<ProviderDto> OnEdit { get; set; }
    [Parameter] public EventCallback<string> OnCheckLatency { get; set; }

    private string GetCardClass()
    {
        return IsActive
            ? "bg-primary/[0.04] border-primary/40 shadow-sm"
            : "bg-card border-border/60 hover:border-border hover:bg-muted/20";
    }

    private string GetLatencyClass(long ms)
    {
        if (ms < 500) return "text-emerald-500 dark:text-emerald-400";
        if (ms < 1500) return "text-amber-500 dark:text-amber-400";
        return "text-rose-500 dark:text-rose-400";
    }

    private async Task HandleSwitch()
    {
        await ProviderState.SwitchProviderAsync(Provider.Id);
    }
}
