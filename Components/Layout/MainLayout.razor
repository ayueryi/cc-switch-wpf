@inherits LayoutComponentBase
@inject ThemeStateService ThemeState
@inject AppStateService AppState
@inject WindowNativeService WindowService
@inject IJSRuntime JS
@implements IDisposable

<div class="h-screen w-screen flex flex-col overflow-hidden bg-background text-foreground @(ThemeState.IsDark ? "dark" : "")">
    <!-- Top Custom TitleBar -->
    <TitleBar />

    <!-- Main Content Area -->
    <main class="flex-1 overflow-hidden relative flex flex-col bg-background">
        @(ChildContent ?? Body)
    </main>

    <!-- Global Toast Notifications -->
    <ToastContainer />
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        ThemeState.OnThemeChanged += HandleThemeChanged;
        AppState.OnStateChanged += HandleStateChanged;
        WindowService.OnWindowStateChanged += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SyncThemeToDomAsync();
        }
    }

    private async void HandleThemeChanged()
    {
        await InvokeAsync(async () =>
        {
            await SyncThemeToDomAsync();
            StateHasChanged();
        });
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task SyncThemeToDomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("__setTheme", ThemeState.IsDark);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MainLayout] SyncThemeToDom failed: {ex.Message}");
        }
    }

    public void Dispose()
    {
        ThemeState.OnThemeChanged -= HandleThemeChanged;
        AppState.OnStateChanged -= HandleStateChanged;
        WindowService.OnWindowStateChanged -= HandleStateChanged;
    }
}

